# --- База данных ---
DATABASE_URL=postgresql+asyncpg://cloud5:cloud5@localhost:5432/cloud5

# --- Redis (FSM-состояния) ---
REDIS_URL=redis://localhost:6379/0

# --- ИИ (Anthropic Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
# Модель по умолчанию для ИИ-ассистента
AI_MODEL=claude-sonnet-4-6

# --- Режим запуска ботов ---
# polling — для разработки; webhook — для продакшена
BOT_MODE=polling
# Базовый публичный URL для webhook (только при BOT_MODE=webhook)
WEBHOOK_BASE_URL=https://bots.example.com
WEBHOOK_SECRET=change-me-please

# --- Админ-API ---
ADMIN_API_TOKEN=change-me-admin-token

# --- Прочее ---
LOG_LEVEL=INFO
DEFAULT_LOCALE=ru
