# Конфиг для запуска на телефоне (Termux) — без PostgreSQL и Redis.
# Скопируйте в .env:  cp .env.termux.example .env

# SQLite-файл вместо PostgreSQL (ничего ставить не нужно)
DATABASE_URL=sqlite+aiosqlite:///./cloud5.db

# Пусто = FSM-состояния хранятся в памяти (Redis не нужен)
REDIS_URL=

# Боты в режиме polling — то, что нужно для телефона
BOT_MODE=polling

LOG_LEVEL=INFO
DEFAULT_LOCALE=ru

# Глобальные админы (впиши свой Telegram ID) — доступ к /admin, /testdonate, /setwall
DEFAULT_ADMIN_IDS=7164355388
