# Локальная разработка (SQLite — ничего ставить не нужно)
DATABASE_URL="file:./dev.db"

# Секрет для подписи JWT-сессий. На проде задайте длинную случайную строку.
AUTH_SECRET="dev-secret-change-me-to-a-long-random-string"

# --- Для деплоя на Vercel ---
# 1) В schema.prisma смените provider на "postgresql"
# 2) Подключите Vercel Postgres / Neon и задайте сюда строку подключения:
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
