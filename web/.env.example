# PostgreSQL (прод и локалка). Возьми строку из Neon или Vercel Postgres.
# Neon: https://neon.tech → создай проект → Connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Секрет для подписи JWT-сессий — задай длинную случайную строку.
AUTH_SECRET="change-me-to-a-long-random-string"
